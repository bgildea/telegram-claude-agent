# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Comma-separated Telegram chat IDs allowed to use the bot. Empty means nobody.
ALLOWED_CHAT_IDS=
ANTHROPIC_MODEL=claude-sonnet-5-5
DEFAULT_TIMEZONE=Asia/Bangkok
MEMORY_PATH=agent.db
# Tokens (input plus output) each chat may use per day. Empty means no limit.
DAILY_TOKEN_BUDGET=
